{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tambouille-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "tambouille-local",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set NEXT_PUBLIC_FORCE_LOCAL=1&& npx next dev -p 3002"],
      "port": 3002
    },
    {
      "name": "tambouille-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3001"],
      "port": 3001
    }
  ]
}
