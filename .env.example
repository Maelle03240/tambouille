# Copier ce fichier en .env.local (en local) ou saisir ces variables dans
# Vercel → Settings → Environment Variables. Ne jamais publier les vraies valeurs.
# Une variable absente désactive simplement la fonction correspondante.

# ── Supabase (Project Settings → API). Sans elles : mode local (données dans le navigateur).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Réservée aux usages serveur futurs (illustrations V2). Jamais côté navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# ── Lecture des recettes par IA (https://aistudio.google.com/apikey, niveau gratuit)
GEMINI_API_KEY=
# Facultatif : modèle précis (défaut : gemini-flash-latest)
GEMINI_MODEL=

# ── Illustrations IA (V2, facultatif) — Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
